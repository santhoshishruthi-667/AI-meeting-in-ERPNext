{
  "name": "ai-meeting-in-erpnext",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "py backend/main.py",
    "frontend": "cmd.exe /c npm --prefix frontend run dev",
